# Development environment variables — copy to .env and fill in secrets
DATABASE_URL=sqlite+aiosqlite:///./ghostrescue.db
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ghostrescue
DEBUG=false
NEWSAPI_KEY=

# CourtListener — token auth for REST API access
COURTLISTENER_API_TOKEN=

# X / Twitter
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional AI enrichment providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Secure temporary investigation chat (optional but recommended)
TEMPORARY_CHAT_ENABLED=true
TEMPORARY_CHAT_ACCESS_KEY=
TEMPORARY_CHAT_MAX_MESSAGES=12
TEMPORARY_CHAT_MAX_CONTEXT_CHARS=24000
TEMPORARY_SESSION_TTL_MINUTES=90
TEMPORARY_SENSITIVE_ALLOWED_ROLES=trusted_operator,senior_analyst
