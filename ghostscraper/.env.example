APP_NAME=GhostScraper
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_USER_AGENT=Mozilla/5.0 GhostScraper/1.0
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_FETCHES=5
PLAYWRIGHT_HEADLESS=true
STORAGE_ROOT=./storage
ENABLE_SEMANTIC_EXTRACTION=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESPECT_ROBOTS_TXT=true
DISCOVERY_PROVIDER=auto
DISCOVERY_TIMEOUT_SECONDS=10
ASYNC_QUEUE_MAXSIZE=100
